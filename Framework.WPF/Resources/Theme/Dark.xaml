<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PALETTE SOMBRE. Mêmes clés que Light.xaml : une clé posée seulement
         ici (ou seulement là) serait invisible sur l'autre thème. -->

    <Color x:Key="Color.Window">#FF14181D</Color>
    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />

    <SolidColorBrush x:Key="Brush.Surface" Color="#FF1D232B" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FF171C23" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF2A323D" />

    <SolidColorBrush x:Key="Brush.Text" Color="#FFE6EAF0" />
    <SolidColorBrush x:Key="Brush.TextSecondaire" Color="#FF9AA7B5" />

    <SolidColorBrush x:Key="Brush.Accente" Color="#FF14B8A6" />
    <SolidColorBrush x:Key="Brush.TexteSurAccente" Color="#FF08211D" />

    <SolidColorBrush x:Key="Brush.NavSurvol" Color="#FF232B35" />
    <SolidColorBrush x:Key="Brush.NavSelection" Color="#FF1E3A36" />

    <SolidColorBrush x:Key="Brush.Succes" Color="#FF3FCB89" />
    <SolidColorBrush x:Key="Brush.Alerte" Color="#FFFFC46B" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFF06C6C" />

    <FontFamily x:Key="Font.App">Segoe UI</FontFamily>

</ResourceDictionary>
