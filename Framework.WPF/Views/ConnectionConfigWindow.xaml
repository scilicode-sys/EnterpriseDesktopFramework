<Window x:Class="Framework.WPF.Views.ConnectionConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration réseau — base de données"
        Width="480" Height="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource Font.App}"
        Background="{DynamicResource Brush.Window}">

    <Grid VerticalAlignment="Center" Margin="32,0">
        <Border Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                CornerRadius="10" Padding="24">

            <StackPanel>

                <Border Background="{DynamicResource Brush.Accente}" CornerRadius="8"
                        Width="40" Height="40" HorizontalAlignment="Left">
                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource Brush.TexteSurAccente}"
                               FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="Connexion PostgreSQL"
                           FontSize="18" FontWeight="SemiBold" Margin="0,14,0,2"
                           Foreground="{DynamicResource Brush.Text}" />

                <TextBlock Text="Serveur, base et compte de ce poste. Les réglages sont testés avant d'être enregistrés."
                           FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondaire}" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Serveur" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Brush.TextSecondaire}" />
                        <TextBox Style="{StaticResource ChampTexte}"
                                 Text="{Binding Hote, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Port" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Brush.TextSecondaire}" />
                        <TextBox Style="{StaticResource ChampTexte}"
                                 Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Nom de la base" FontSize="12" Margin="0,0,0,4"
                           Foreground="{DynamicResource Brush.TextSecondaire}" />
                <TextBox Style="{StaticResource ChampTexte}"
                         Text="{Binding Base, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Utilisateur" FontSize="12" Margin="0,12,0,4"
                           Foreground="{DynamicResource Brush.TextSecondaire}" />
                <TextBox Style="{StaticResource ChampTexte}"
                         Text="{Binding Utilisateur, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Mot de passe" FontSize="12" Margin="0,12,0,4"
                           Foreground="{DynamicResource Brush.TextSecondaire}" />
                <PasswordBox x:Name="ZoneMotDePasse"
                             Background="{DynamicResource Brush.Surface}"
                             Foreground="{DynamicResource Brush.Text}"
                             BorderBrush="{DynamicResource Brush.Border}"
                             BorderThickness="1" Padding="8,6" FontSize="13" />

                <CheckBox Content="Connexion chiffrée (SSL)" Margin="0,12,0,0"
                          IsChecked="{Binding SslRequis}"
                          Foreground="{DynamicResource Brush.Text}" />

                <TextBlock Text="{Binding MessageResultat}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultatPositif}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Succes}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Content="Tester la connexion" Command="{Binding TesterCommand}"
                        Style="{StaticResource BoutonDiscret}"
                        Margin="0,16,0,0"
                        IsEnabled="{Binding EstOccupe, Converter={StaticResource InverseBooleen}}" />

                <Button Content="Enregistrer et fermer" Command="{Binding EnregistrerCommand}"
                        Style="{StaticResource BoutonPrimaire}"
                        Margin="0,10,0,0"
                        IsEnabled="{Binding EstOccupe, Converter={StaticResource InverseBooleen}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
