<UserControl x:Class="Framework.WPF.Views.DroitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Font.App}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">

            <TextBlock Text="Matrice des rôles et permissions" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}" />

            <TextBlock Text="{Binding SessionCourante}" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.TextSecondaire}" />

            <TextBlock Text="{Binding Avertissement}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,10,0,0" MaxWidth="760" HorizontalAlignment="Left"
                       Foreground="{DynamicResource Brush.Alerte}"
                       Visibility="{Binding EstAvertissementVisible, Converter={StaticResource BooleenVersVisibilite}}" />

            <Button Content="Recharger" Command="{Binding RechargerCommand}"
                    Style="{StaticResource BoutonDiscret}" HorizontalAlignment="Left"
                    Margin="0,14,0,0" />

            <ItemsControl ItemsSource="{Binding Roles}" Margin="0,18,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16" Margin="0,0,0,12" MaxWidth="760" HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Libelle}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text}" />
                                    <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="4"
                                            Background="{DynamicResource Brush.Accente}"
                                            Visibility="{Binding EstRoleCourant, Converter={StaticResource BooleenVersVisibilite}}">
                                        <TextBlock Text="session courante" FontSize="11"
                                                   Foreground="{DynamicResource Brush.TexteSurAccente}" />
                                    </Border>
                                    <TextBlock Text="{Binding Compte}" FontSize="11" Margin="12,3,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondaire}" />
                                </StackPanel>

                                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondaire}" />

                                <TextBlock FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Text}">
                                    <Run Text="Hérite de : " /><Run Text="{Binding HeriteDe}" />
                                </TextBlock>

                                <TextBlock Text="{Binding Resume}" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondaire}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
