<UserControl x:Class="Framework.WPF.Views.ComptesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Font.App}">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- ===================== LISTE ===================== -->
        <DockPanel Grid.Column="0" Margin="0,0,18,0">

            <Border DockPanel.Dock="Top" Padding="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource ChampTexte}"
                             Text="{Binding Filtre, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="1" Content="Actualiser"
                            Style="{StaticResource BoutonDiscret}" Margin="10,0,0,0"
                            Command="{Binding RechargerCommand}" />

                    <Button Grid.Column="2" Content="Nouveau compte"
                            Style="{StaticResource BoutonPrimaire}" Margin="10,0,0,0"
                            Command="{Binding NouveauCommand}" />
                </Grid>
            </Border>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Etat}"
                       FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondaire}" />

            <DataGrid ItemsSource="{Binding Lignes}"
                      SelectedItem="{Binding LigneSelectionnee, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserResizeRows="False" SelectionMode="Single"
                      Background="{DynamicResource Brush.Surface}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      RowBackground="{DynamicResource Brush.Surface}"
                      AlternatingRowBackground="{DynamicResource Brush.Window}"
                      Foreground="{DynamicResource Brush.Text}"
                      HorizontalGridLinesBrush="{DynamicResource Brush.Border}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Identifiant" Binding="{Binding Username}" Width="150" />
                    <DataGridTextColumn Header="Nom complet" Binding="{Binding NomComplet}" Width="*" />
                    <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="130" />
                    <DataGridTextColumn Header="État" Binding="{Binding Etat}" Width="100" />
                    <DataGridTextColumn Header="Anti-force-brute" Binding="{Binding Securite}" Width="160" />
                    <DataGridTextColumn Header="Session" Binding="{Binding Marque}" Width="150" />
                    <DataGridTextColumn Header="Dernière modification"
                                        Binding="{Binding DerniereModification}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- ===================== FORMULAIRE ===================== -->
        <Border Grid.Column="1" Padding="18" VerticalAlignment="Top"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                CornerRadius="8">

            <StackPanel>
                <TextBlock Text="{Binding LibelleFormulaire}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" />

                <TextBlock Text="Identifiant de connexion" FontSize="12" Margin="0,16,0,4"
                           Foreground="{DynamicResource Brush.TextSecondaire}" />
                <TextBox Style="{StaticResource ChampTexte}"
                         Text="{Binding Identifiant, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Nom complet" FontSize="12" Margin="0,12,0,4"
                           Foreground="{DynamicResource Brush.TextSecondaire}" />
                <TextBox Style="{StaticResource ChampTexte}"
                         Text="{Binding NomComplet, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Rôle (déclaré dans la matrice)" FontSize="12" Margin="0,12,0,4"
                           Foreground="{DynamicResource Brush.TextSecondaire}" />
                <ComboBox ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding RoleSelectionne}"
                          Background="{DynamicResource Brush.Surface}"
                          Foreground="{DynamicResource Brush.Text}"
                          BorderBrush="{DynamicResource Brush.Border}"
                          Padding="8,6" FontSize="13" />

                <TextBlock Text="Mot de passe" FontSize="12" Margin="0,12,0,4"
                           Foreground="{DynamicResource Brush.TextSecondaire}" />
                <PasswordBox x:Name="ZoneMotDePasse"
                             Background="{DynamicResource Brush.Surface}"
                             Foreground="{DynamicResource Brush.Text}"
                             BorderBrush="{DynamicResource Brush.Border}"
                             Padding="8,6" FontSize="13" />

                <TextBlock Text="{Binding ConsigneMotDePasse}" FontSize="11" Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.TextSecondaire}" TextWrapping="Wrap" />

                <TextBlock Text="Confirmation" FontSize="12" Margin="0,10,0,4"
                           Foreground="{DynamicResource Brush.TextSecondaire}" />
                <PasswordBox x:Name="ZoneConfirmation"
                             Background="{DynamicResource Brush.Surface}"
                             Foreground="{DynamicResource Brush.Text}"
                             BorderBrush="{DynamicResource Brush.Border}"
                             Padding="8,6" FontSize="13" />

                <CheckBox Content="Compte actif" IsChecked="{Binding Actif}"
                          Margin="0,14,0,0" FontSize="13"
                          Foreground="{DynamicResource Brush.Text}" />

                <TextBlock Text="{Binding MessageErreur}"
                           Foreground="{DynamicResource Brush.Danger}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding MessageErreur, Converter={StaticResource TexteVersVisibilite}}" />

                <Button Content="Enregistrer" Command="{Binding EnregistrerCommand}"
                        Style="{StaticResource BoutonPrimaire}" Margin="0,18,0,0"
                        IsEnabled="{Binding BoutonEnregistrerActif}" />

                <Button Content="Activer / désactiver" Command="{Binding BasculerActifCommand}"
                        Style="{StaticResource BoutonDiscret}" Margin="0,10,0,0"
                        IsEnabled="{Binding BoutonBasculerActif}" />

                <Button Content="Lever le gel de connexion" Command="{Binding DegelerCommand}"
                        Style="{StaticResource BoutonDiscret}" Margin="0,4,0,0"
                        IsEnabled="{Binding BoutonDegelerActif}" />

                <Button Content="Supprimer le compte" Command="{Binding SupprimerCommand}"
                        Style="{StaticResource BoutonDiscret}" Margin="0,4,0,0"
                        Foreground="{DynamicResource Brush.Danger}"
                        IsEnabled="{Binding BoutonSupprimerActif}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
