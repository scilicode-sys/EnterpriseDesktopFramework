<Window x:Class="Framework.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Framework Desktop"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource Font.App}"
        Background="{DynamicResource Brush.Window}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LargeurSidebar}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- BARRE LATÉRALE RÉTRACTABLE -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">

            <DockPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button Command="{Binding BasculerSidebarCommand}"
                            Style="{StaticResource BoutonDiscret}"
                            Margin="8,10,8,2" Padding="8,4"
                            ToolTip="Réduire / agrandir la barre latérale">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource Brush.Text}" />
                    </Button>

                    <!-- Sélecteur de navigation -->
                    <ListBox Margin="0,8,0,0"
                             Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding ItemSelectionne}"
                             ItemContainerStyle="{StaticResource ItemNavigation}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="15" Width="22"
                                               Foreground="{DynamicResource Brush.Text}" />
                                    <TextBlock Text="{Binding Libelle}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text}"
                                               Visibility="{Binding DataContext.SidebarDepliee,
                                                    RelativeSource={RelativeSource AncestorType=ListBox},
                                                    Converter={StaticResource BooleenVersVisibilite}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- PIED DE BARRE : thème, utilisateur, session -->
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,10">

                    <Button Command="{Binding BasculerThemeCommand}"
                            Style="{StaticResource BoutonDiscret}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"
                                       Foreground="{DynamicResource Brush.TextSecondaire}" />
                            <TextBlock Text="Thème" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondaire}"
                                       Visibility="{Binding DataContext.SidebarDepliee,
                                            RelativeSource={RelativeSource AncestorType=Window},
                                            Converter={StaticResource BooleenVersVisibilite}}" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="4,8,0,0">
                        <Border Background="{DynamicResource Brush.Accente}" CornerRadius="12"
                                Width="24" Height="24">
                            <TextBlock Text="{Binding NomUtilisateur, Converter={StaticResource Initiales}}"
                                       Foreground="{DynamicResource Brush.TexteSurAccente}"
                                       FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding DataContext.SidebarDepliee,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BooleenVersVisibilite}}">
                            <TextBlock Text="{Binding NomUtilisateur}" FontSize="12"
                                       Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="{Binding RoleUtilisateur}" FontSize="10"
                                       Foreground="{DynamicResource Brush.TextSecondaire}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Command="{Binding FermerSessionCommand}"
                            Style="{StaticResource BoutonDiscret}" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22"
                                       Foreground="{DynamicResource Brush.TextSecondaire}" />
                            <TextBlock Text="Fermer la session" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondaire}"
                                       Visibility="{Binding DataContext.SidebarDepliee,
                                            RelativeSource={RelativeSource AncestorType=Window},
                                            Converter={StaticResource BooleenVersVisibilite}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ZONE DE CONTENU -->
        <DockPanel Grid.Column="1">

            <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                    Padding="16,8">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding RevenirCommand}"
                                Style="{StaticResource BoutonDiscret}"
                                ToolTip="Retour"
                                IsEnabled="{Binding CanRetour}">
                            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource Brush.TextSecondaire}" />
                        </Button>
                        <TextBlock Text="{Binding TitreCourant}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource Brush.Text}" />
                    </StackPanel>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.NavSurvol}" CornerRadius="10" Padding="10,3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Succes}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding EtatSynchronisation}" FontSize="11" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Brush.TextSecondaire}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Le ViewModel courant se résout en vue par DataTemplate implicite. -->
            <ContentControl Content="{Binding ViewModelCourant}" />
        </DockPanel>
    </Grid>
</Window>
