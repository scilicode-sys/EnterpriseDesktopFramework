<Application x:Class="Framework.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Framework.WPF.ViewModels"
             xmlns:views="clr-namespace:Framework.WPF.Views"
             xmlns:conv="clr-namespace:Framework.WPF.Converters"
             ShutdownMode="OnLastWindowClose">

    <!-- Pas de StartupUri : la fenêtre initiale est décidée par le code
         (connexion d'abord, shell ensuite). -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Theme/Controls.xaml" />
                <ResourceDictionary Source="/Resources/Theme/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BooleenVersVisibilite x:Key="BooleenVersVisibilite" />
            <conv:Initiales x:Key="Initiales" />
            <conv:TexteVersVisibilite x:Key="TexteVersVisibilite" />
            <conv:InverseBooleen x:Key="InverseBooleen" />
            <conv:LibelleModeConnexion x:Key="LibelleModeConnexion" />

            <!-- Navigation par ViewModel : le ContentControl du shell résout
                 la vue par ce template implicite. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ExempleViewModel}">
                <views:ExempleView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>

</Application>
